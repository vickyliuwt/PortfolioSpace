# ====================================================================
# optional. the app already runs on sensible localhost defaults,
# so you only need this file if you want to change something
# (or switch storage to real AWS S3 later).
# copy to server/.env to use it:  cp .env.example .env
# ====================================================================

# ---- sessions (shared across every service) ----
# all services MUST use the same secret so one login works everywhere
SESSION_SECRET=paw_dev_secret_change_me
REDIS_URL=redis://127.0.0.1:6379

# ---- database ----
MONGO_URL=mongodb://127.0.0.1:27017/portfoliospace

# ---- where the browser app runs (for cors + cookies) ----
CLIENT_URL=http://localhost:3000

# ---- gateway -> services (leave as-is for local npm) ----
AUTH_URL=http://127.0.0.1:4001
PORTFOLIO_URL=http://127.0.0.1:4002
MEDIA_URL=http://127.0.0.1:4003

# ---- free tier cap (pro = unlimited) ----
FREE_PROJECT_LIMIT=3

# drop demo creators + projects on portfolio boot
SEED_ON_START=false

# ---- storage: MinIO locally = free ----
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=portfoliospace
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- to use real AWS S3 instead (optional, costs money) ----
# STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
