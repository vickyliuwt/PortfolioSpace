# ====================================================================
# optional. the app runs on localhost defaults, so you only need this
# file if you want to change something.
# copy it to server/.env to use it:  cp .env.example server/.env
# ====================================================================

# ---- sessions (shared across every service) ----
# all services MUST use the same secret so one login works everywhere
SESSION_SECRET=paw_dev_secret_change_me
REDIS_URL=redis://127.0.0.1:6379

# ---- database ----
MONGO_URL=mongodb://127.0.0.1:27017/portfoliospace

# ---- where the browser app runs (for cors + cookies) ----
CLIENT_URL=http://localhost:3000

# ---- gateway -> services (leave as-is for local npm) ----
AUTH_URL=http://127.0.0.1:4001
PORTFOLIO_URL=http://127.0.0.1:4002
MEDIA_URL=http://127.0.0.1:4003
SEARCH_URL=http://127.0.0.1:4004
MODERATION_URL=http://127.0.0.1:4005

# requests per 15 minutes per ip at the gateway
RATE_LIMIT=600

# ---- token login (the cookie session works without any of this) ----
# falls back to SESSION_SECRET when unset
# JWT_SECRET=another_secret
# how long a bearer token lasts, in seconds
JWT_TTL_SECONDS=604800

# ---- project cap ----
# 0 or unset = no cap, every plan holds as many projects as you like
BASIC_PROJECT_LIMIT=0

# drop demo creators + projects on portfolio boot
SEED_ON_START=false

# set to false to bypass the redis read cache while debugging
CACHE_ENABLED=true

# ---- storage: MinIO locally ----
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=portfoliospace
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# rewrite upload urls through another host if you put a proxy in front
# MEDIA_PUBLIC_URL=http://127.0.0.1:4003

# ---- to point at AWS S3 instead (optional) ----
# STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET

# ---- search (only needed with the elasticsearch profile) ----
# search falls back to mongo when this is unreachable
ES_URL=http://127.0.0.1:9200
ES_PROJECT_INDEX=ps-projects
ES_MESSAGE_INDEX=ps-messages

# ---- client ----
# put this one in client/.env.local, not here
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
